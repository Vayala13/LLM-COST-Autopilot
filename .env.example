# LLM Cost AutoPilot — example environment (Phase 5.3)
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Docker Compose loads `.env` via `env_file` (optional). Nothing here is a secret.

# --- LLM provider keys (optional; missing key → that provider skips / 503) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- API (portfolio / local is unauthenticated — do not expose publicly) ---
# Gate PUT /v1/routing-config YAML writes. Default on for demos. Set 0 in
# non-local deploys. This is NOT authentication.
ALLOW_ROUTING_CONFIG_WRITE=1

# --- Worker (shared data/ volume; does not drain API in-process verify queue) ---
# Seconds between worker loops (retrain check + JSONL status).
WORKER_INTERVAL_S=300
# Set to 0 to disable automatic retrain_from_feedback.
WORKER_RETRAIN=1
# Minimum feedback_prompts.jsonl rows before a retrain runs.
WORKER_MIN_FEEDBACK=1
