# Secrets & local env — never bake into the image
.env
.env.*
!.env.example

# Virtualenv / caches
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Git / editor / Cursor
.git/
.cursor/
*.local.md

# Runtime data that belongs on the compose volume (not the image)
data/requests.db
data/requests.db-*
data/routing_failures.jsonl
data/escalations.jsonl
data/feedback_prompts.jsonl
data/prompt_features.json

# Smoke / temp configs
configs/_smoke_*.yaml
configs/*.yaml.tmp
configs/*.yml.tmp

# Docs / portfolio site (not needed at runtime)
portfolio/
AGENTS.md
architecture-diagram.png
README.md
